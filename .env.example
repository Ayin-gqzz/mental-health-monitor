# Database — SQLite is the default (zero-config). Switch to MySQL by uncommenting below:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mental_health
DATABASE_URL=sqlite:///./mental_health.db

# JWT signing secret — generate a random string for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-secret

# Optional: LLM integration for intervention suggestions
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.openai.com/v1

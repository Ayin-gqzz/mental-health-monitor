# Database — MySQL (推荐) 或 SQLite
# MySQL 配置：
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/mental_health?charset=utf8mb4
# SQLite 配置（无需安装数据库）：
# DATABASE_URL=sqlite:///./mental_health.db

# JWT signing secret — 生成随机密钥：
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-secret

# LLM 配置（用于 AI 智能回复功能）
# 支持 OpenAI 兼容 API（如 MiMo、GPT、DeepSeek 等）
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.openai.com/v1
